# ── Shakedown 环境变量示例（复制成 .env 后按需修改）────────────────
# 所有变量统一使用 SHAKEDOWN_ 前缀。

# ── 数据库 ──────────────────────────────────────────────
SHAKEDOWN_DATABASE_URL=postgresql+psycopg://shakedown:shakedown@localhost:5432/shakedown
SHAKEDOWN_DB_POOL_SIZE=5

# ── LLM provider ─────────────────────────────────────────
# mock   = 离线确定性规则版 Agent（无需任何外部服务）
# openai = 任意 OpenAI 兼容接口（vLLM / Ollama / OpenCode Go / OpenAI ...）
# skipper= 复用 skipper 项目的 LLM 配置
# LLM_BASE_URL 填到 /v1 即可；直接粘贴完整 /v1/chat/completions 也能工作。
# OpenCode Go 会自动带上 x-opencode-session 与自定义 User-Agent。
SHAKEDOWN_LLM_PROVIDER=mock
SHAKEDOWN_LLM_BASE_URL=http://localhost:11434/v1
SHAKEDOWN_LLM_API_KEY=
SHAKEDOWN_LLM_MODEL=shakedown-mock
SHAKEDOWN_LLM_TEMPERATURE=0.2
# 单个批次硬超时（秒），防止上游模型挂住拖死整个生成任务
SHAKEDOWN_LLM_JOB_TIMEOUT=360
# 生成用例时的模型并发数；上游不稳定时降到 1 更可靠
SHAKEDOWN_LLM_CONCURRENCY=1

# ── Embedding ───────────────────────────────────────────
SHAKEDOWN_EMBEDDING_PROVIDER=hash
SHAKEDOWN_EMBEDDING_DIM=1536

# ── 沙箱 ─────────────────────────────────────────────────
# berth = 用 berth 沙箱执行；local = 本地临时目录（开发降级）
SHAKEDOWN_SANDBOX_MODE=local
SHAKEDOWN_BERTH_BASE_URL=http://localhost:9000
SHAKEDOWN_BERTH_TOKEN=
SHAKEDOWN_BERTH_IMAGE=base
SHAKEDOWN_BERTH_RUNNER_IMAGE=runner
SHAKEDOWN_SANDBOX_TIMEOUT=600

# ── Worker ──────────────────────────────────────────────
SHAKEDOWN_WORKER_ENABLED=true
SHAKEDOWN_WORKER_CONCURRENCY=2
SHAKEDOWN_WORKER_POLL_INTERVAL=2

# ── 缺陷工单集成 ─────────────────────────────────────────
# 凭据 / 服务地址（全局）；仓库 / Jira 项目在项目设置里配置，项目为空时回退到这里。
SHAKEDOWN_GITHUB_TOKEN=
SHAKEDOWN_GITHUB_API_URL=https://api.github.com
SHAKEDOWN_GITHUB_REPO=
SHAKEDOWN_GITHUB_LABELS=
SHAKEDOWN_JIRA_BASE_URL=
SHAKEDOWN_JIRA_EMAIL=
SHAKEDOWN_JIRA_API_TOKEN=
SHAKEDOWN_JIRA_PROJECT_KEY=
SHAKEDOWN_JIRA_ISSUE_TYPE=Bug

# ── MCP HTTP ──────────────────────────────────────────────
SHAKEDOWN_MCP_REQUIRE_AUTH=true
SHAKEDOWN_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:8000,localhost,localhost:8000

# ── 安全 ─────────────────────────────────────────────────
# 敏感配置（测试账号 / 被测库 DSN）的加密密钥；留空则自动生成到 var/secret.key
SHAKEDOWN_ENCRYPTION_KEY=
SHAKEDOWN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 其它 ─────────────────────────────────────────────────
SHAKEDOWN_LOG_LEVEL=INFO
SHAKEDOWN_LOG_JSON=false
